{
  "name": "xuli-resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs",
    "projects:validate": "node scripts/sync-github-projects.mjs validate",
    "projects:scan": "node scripts/sync-github-projects.mjs scan",
    "sync:vibe-journal": "node scripts/sync-vibe-journal.mjs",
    "sync:vibe-journal:dry": "node scripts/sync-vibe-journal.mjs --dry-run"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
